generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaffDocumentationAcknowledgement {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model Admin {
  id                      Int                          @id @default(autoincrement())
  name                    String
  email                   String                       @unique(map: "Admin_email_unique")
  passwordHash            String
  resetToken              String?
  resetTokenExpiry        DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  clients                 Client[]
  logs                    FormActivityLog[]
  assignedFormAssignments FormAssignment[]             @relation("AssignedForms")
  notifications           FormSubmissionNotification[]
  appSettings             AppSettings[]
}

model Client {
  id             Int                          @id @default(autoincrement())
  name           String?
  email          String?                      @unique
  phone          String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  createdById    Int?
  createdBy      Admin?                       @relation(fields: [createdById], references: [id])
  commonFields   CommonField?
  logs           FormActivityLog[]
  FormAssignment FormAssignment[]
  formBatches    FormBatch[]
  progress       FormProgress[]
  forms          FormSubmission[]
  notifications  FormSubmissionNotification[]
  insights       Insight[]
}

model Staff {
  id                           Int                                @id @default(autoincrement())
  firstName                    String
  surname                      String
  email                        String                             @unique
  phone                        String?
  role                         String?
  status                       String                             @default("pending")
  startDate                    DateTime?
  linkToken                    String?                            @unique
  linkExpiresAt                DateTime?
  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt
  bullyingHarassmentTraining   StaffBullyingHarassmentTraining?
  bullyingTraining             StaffBullyingTraining?
  conflictOfInterest           StaffConflictOfInterest?
  documentationAcknowledgement StaffDocumentationAcknowledgement?
  employmentDetails            StaffEmploymentDetails?
  employmentWelcomeAck         StaffEmploymentWelcomeAck?
  formDownloads                StaffFormDownload[]
  submissions                  StaffFormSubmission[]
  ndisCodeOfConduct            StaffNdisCodeOfConduct?
  ndisWorkforceCapability      StaffNdisWorkforceCapability?
  preEmploymentMedical         StaffPreEmploymentMedical?
  supportWorker                StaffSupportWorker?
  vehicleSafetyInspection      StaffVehicleSafetyInspection?
}

model StaffFormSubmission {
  id          Int       @id @default(autoincrement())
  staffId     Int
  formKey     String
  data        Json
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt
  staff       Staff     @relation(fields: [staffId], references: [id])

  @@unique([staffId, formKey])
}

model StaffEmploymentDetails {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffEmploymentWelcomeAck {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffSupportWorker {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffPreEmploymentMedical {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffNdisWorkforceCapability {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffBullyingHarassmentTraining {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffBullyingTraining {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffNdisCodeOfConduct {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffConflictOfInterest {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffVehicleSafetyInspection {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffFormDownload {
  id           Int      @id @default(autoincrement())
  staffId      Int
  formKey      String
  downloadedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  staff        Staff    @relation(fields: [staffId], references: [id])

  @@unique([staffId, formKey])
}

model MasterForm {
  id                Int              @id @default(autoincrement())
  formKey           String           @unique
  title             String
  version           Int
  schema            Json?
  requiresSignature Boolean?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  FormAssignment    FormAssignment[]
  formProgress      FormProgress[]
  formSubmissions   FormSubmission[]

  @@unique([formKey, version])
}

model FormBatch {
  id              Int                  @id @default(autoincrement())
  clientId        Int
  batchToken      String               @unique
  passcode        String?
  expiresAt       DateTime
  createdAt       DateTime             @default(now())
  isSignatureOnly Boolean              @default(false)
  isCompleted     Boolean              @default(false)
  completedAt     DateTime?
  adminNotified   Boolean              @default(false)
  assignments     FormAssignment[]
  client          Client               @relation(fields: [clientId], references: [id])
  signatureForms  SignatureBatchForm[]
}

model FormAssignment {
  id                      Int        @id @default(autoincrement())
  clientId                Int
  formId                  Int
  formVersion             Int
  assignedAt              DateTime   @default(now())
  currentStatus           String     @default("not_started")
  isCompleted             Boolean    @default(false)
  isCommonFieldsCompleted Boolean    @default(false)
  displayOrder            Int        @default(0)
  batchId                 Int
  assignedById            Int?
  assignedBy              Admin?     @relation("AssignedForms", fields: [assignedById], references: [id])
  batch                   FormBatch  @relation(fields: [batchId], references: [id])
  client                  Client     @relation(fields: [clientId], references: [id])
  form                    MasterForm @relation(fields: [formId], references: [id])

  @@unique([clientId, formId, formVersion])
}

model FormSubmission {
  id               Int                          @id @default(autoincrement())
  clientId         Int
  formId           Int
  formVersion      Int
  data             Json
  isSubmitted      Boolean                      @default(false)
  submittedAt      DateTime?
  updatedAt        DateTime                     @updatedAt
  filledByAdmin    Boolean                      @default(false)
  adminFilledAt    DateTime?
  clientSignature  String?
  clientSignedAt   DateTime?
  client           Client                       @relation(fields: [clientId], references: [id])
  form             MasterForm                   @relation(fields: [formId], references: [id])
  notifications    FormSubmissionNotification[]
  signatureBatches SignatureBatchForm[]

  @@unique([clientId, formId, formVersion])
}

model FormProgress {
  id             Int        @id @default(autoincrement())
  clientId       Int
  formId         Int
  formVersion    Int
  currentSection String?
  updatedAt      DateTime   @updatedAt
  client         Client     @relation(fields: [clientId], references: [id])
  form           MasterForm @relation(fields: [formId], references: [id])

  @@unique([clientId, formId, formVersion])
}

model CommonField {
  id         Int      @id @default(autoincrement())
  clientId   Int      @unique
  name       String?
  age        Int?
  email      String?
  sex        String?
  street     String?
  state      String?
  postCode   String?
  dob        String?
  ndis       String?
  disability String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  phone      String?
  surname    String?
  client     Client   @relation(fields: [clientId], references: [id])
}

model Insight {
  id            Int       @id @default(autoincrement())
  clientId      Int
  age           Int?
  location      String?
  disability    String?
  language      String?
  contractStart DateTime?
  contractEnd   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id])
}

model FormActivityLog {
  id        Int      @id @default(autoincrement())
  clientId  Int?
  adminId   Int?
  logType   LogType
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId, adminId])
}

model SignatureBatchForm {
  id               Int            @id @default(autoincrement())
  batchId          Int
  formSubmissionId Int
  createdAt        DateTime       @default(now())
  batch            FormBatch      @relation(fields: [batchId], references: [id])
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@unique([batchId, formSubmissionId])
}

model AppSettings {
  id           Int      @id @default(autoincrement())
  key          String
  value        String?
  type         String
  category     String
  label        String
  description  String?
  isRequired   Boolean  @default(false)
  defaultValue String?
  validation   String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  adminId      Int?
  admin        Admin?   @relation(fields: [adminId], references: [id])

  @@unique([key, adminId])
  @@index([category, adminId])
  @@map("app_settings")
}

model FormSubmissionNotification {
  id               Int            @id @default(autoincrement())
  adminId          Int
  clientId         Int
  formSubmissionId Int
  isRead           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  admin            Admin          @relation(fields: [adminId], references: [id])
  client           Client         @relation(fields: [clientId], references: [id])
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@index([adminId, isRead])
  @@index([createdAt])
}

enum LogType {
  CLIENT
  ADMIN
}
